AddHandler application/x-httpd-php84 .php

Options -Indexes

<IfModule mod_setenvif.c>
	# Das CMS benötigt für seine lokale JavaScript-Ausführung eine eigene CSP.
	SetEnvIf Request_URI "^/admin(?:/|$)" harlekids_cms=1
	# OAuth-Popups müssen ihre Verbindung zum öffnenden CMS-Fenster behalten.
	SetEnvIf Request_URI "^/api/decap-(?:auth|callback)\.php$" harlekids_oauth=1
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Vorhandene Dateien, CMS und PHP-Endpunkte unverändert ausliefern.
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [END]

	# Clientseitige React-Routen an die App weiterreichen.
	RewriteRule ^ index.html [END]
</IfModule>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups" env=!harlekids_oauth
	Header always set Cross-Origin-Resource-Policy "same-site"
	Header always set X-Permitted-Cross-Domain-Policies "none"

	# Gilt nur für die eigentliche Website. PHP-OAuth-Antworten setzen eine
	# eigene, strengere Richtlinie mit einem zufälligen Script-Nonce. Das CMS
	# erhält seine abweichende Richtlinie in /admin/.htaccess.
	<FilesMatch "\.html?$">
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" env=!harlekids_cms
	</FilesMatch>
</IfModule>
